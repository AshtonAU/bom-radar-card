{
  "name": "bom-radar-card",
  "version": "1.13.0",
  "private": true,
  "description": "Australian Bureau of Meteorology rain radar card for Home Assistant using native BOM WMTS tiles",
  "main": "dist/bom-radar-card.js",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "rollup -c",
    "check:release": "node scripts/check-release.mjs",
    "check:upstream": "node scripts/check-bom-upstream.mjs",
    "check:legends": "node scripts/check-bom-legends.mjs",
    "preview:legends": "node scripts/preview-legends.mjs",
    "dev": "rollup -c -w",
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AshtonAU/bom-radar-card"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "bom",
    "radar",
    "australia",
    "weather"
  ],
  "author": "Ashton Turner",
  "license": "MIT",
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.62.4"
  }
}
